<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans  http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
    <!-- Configure java classes as spring bean -->
    <bean id="dieselEng" class="com.it.beans.DieselEngine" primary="true"></bean> 
    <bean id="petrolEng" class="com.it.beans.PetrolEngine" autowire-candidate="false"></bean>
    
    <!-- Autowire byName: So we must use 'eng' as id -->
	<!-- <bean id="eng" class="com.it.beans.PetrolEngine" />  -->


	<!-- if we want to use byType or constructor then make one of the bean class as primary -->
	<!-- If one interface having 2 implementations then there is a chance of getting Ambiguity problem. To overcome that we need to use 'autowire-candidate' attribute. -->
	
	
    <!-- Target bean -->
    <!-- <bean id="car" class="com.it.beans.Car" autowire="byType" />   -->
    	 <!-- for constructor and byType we can use autowire-candidate as true or false to solve ambiguity problem -->
    <!-- <bean id="car" class="com.it.beans.Car" autowire="constructor" />   -->
	<bean id="car" class="com.it.beans.Car">
    	 <!-- Use <constructor-arg> Instead of autowire  -->
    	 <constructor-arg ref="petrolEng" />
    </bean>    
	   
</beans> 

